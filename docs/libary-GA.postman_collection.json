{
  "info": {
    "name": "libary-GA API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "staff_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "borrow_from",
      "value": ""
    },
    {
      "key": "borrow_to",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = (n) => { const x = new Date(); x.setDate(x.getDate()+n); return x.toISOString().slice(0,10); };",
          "pm.collectionVariables.set('borrow_from', d(5));",
          "pm.collectionVariables.set('borrow_to', d(10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "Staff login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/staff/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ali2@gmail.com\",\n  \"password\": \"12345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('staff_token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Staff me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
